# --- Database ---
# 설정 시 실제 PostgreSQL 데이터를 사용합니다. 비워두면 목업(mock) 데이터로 동작합니다.
DATABASE_URL="postgresql://user:password@localhost:5432/tastymap?schema=public"

# --- NextAuth (Auth.js v5) ---
AUTH_SECRET="openssl rand -base64 33 으로 생성한 값"
AUTH_URL="http://localhost:3000"

# OAuth Provider (선택)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Maps SDK ---
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
